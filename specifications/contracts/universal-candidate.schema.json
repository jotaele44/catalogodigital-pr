{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:udc:universal:candidate:0.1.0",
  "$defs": {
    "resource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "kind": {
          "enum": [
            "dataset",
            "series",
            "document",
            "software",
            "model",
            "imagery",
            "audio",
            "video",
            "stream",
            "service",
            "composite",
            "opaque"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(K[0-9]{3,}|U[0-9]{2})$"
          },
          "uniqueItems": true
        },
        "classification": {
          "enum": [
            "CANDIDATE",
            "UNCLASSIFIED",
            "CONFLICTING"
          ]
        },
        "status": {
          "enum": [
            "DRAFT",
            "QUARANTINED"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "subjects",
        "classification",
        "status"
      ],
      "additionalProperties": false
    },
    "geography": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "applicability": {
          "enum": [
            "DIRECT",
            "INTERSECTING",
            "CONTEXTUAL",
            "GLOBAL",
            "NONSPATIAL",
            "UNKNOWN"
          ]
        },
        "geometry_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "crs": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "authority_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "applicability",
        "geometry_ref",
        "crs",
        "authority_ref",
        "evidence_ref"
      ],
      "additionalProperties": false
    },
    "temporal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "axis": {
          "enum": [
            "OBSERVATION",
            "VALID",
            "PUBLICATION",
            "ACQUISITION",
            "REVISION",
            "FORECAST",
            "FISCAL"
          ]
        },
        "start": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "enum": [
            "INSTANT",
            "DAY",
            "MONTH",
            "YEAR",
            "INTERVAL",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "id",
        "axis",
        "start",
        "end",
        "precision"
      ],
      "additionalProperties": false
    },
    "rights": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "access": {
          "enum": [
            "PUBLIC",
            "AUTHENTICATED",
            "RESTRICTED",
            "COMMERCIAL",
            "UNKNOWN"
          ]
        },
        "redistribution": {
          "enum": [
            "PERMITTED",
            "PROHIBITED",
            "CONDITIONAL",
            "UNKNOWN"
          ]
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "access",
        "redistribution",
        "license_id",
        "evidence_ref"
      ],
      "additionalProperties": false
    },
    "source_binding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "resource_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "authority_namespace": {
          "type": "string",
          "minLength": 1
        },
        "native_type": {
          "type": "string",
          "minLength": 1
        },
        "native_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "resource_id",
        "authority_namespace",
        "native_type",
        "native_id",
        "scope"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "source_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "acquired_at": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "source_ref",
        "acquired_at",
        "sha256",
        "byte_count",
        "artifact_ref"
      ],
      "additionalProperties": false
    },
    "version": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "resource_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "previous_version_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "state": {
          "enum": [
            "CANDIDATE",
            "SUPERSEDED",
            "WITHDRAWN"
          ]
        }
      },
      "required": [
        "id",
        "resource_id",
        "label",
        "previous_version_id",
        "receipt_id",
        "state"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/resource"
    },
    {
      "$ref": "#/$defs/geography"
    },
    {
      "$ref": "#/$defs/temporal"
    },
    {
      "$ref": "#/$defs/rights"
    },
    {
      "$ref": "#/$defs/source_binding"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/version"
    }
  ]
}
